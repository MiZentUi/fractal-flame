{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run gen-api && vite",
    "build": "npm run gen-api && vue-tsc -b && vite build",
    "preview": "npm run gen-api && vite preview",
