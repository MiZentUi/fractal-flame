  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pixelarticons": "^2.1.1",
    "primeicons": "^7.0.0",
    "reka-ui": "^2.9.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-svg-loader": "^5.1.1",
    "vue-tsc": "^3.2.8"
